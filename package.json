{
	"name": "mui-lite-monorepo",
	"private": true,
	"type": "module",
	"workspaces": ["packages/*", "apps/*"],
	"scripts": {
		"test": "bun test packages/mui-lite/tests",
		"test:watch": "bun test --watch packages/mui-lite/tests",
		"typecheck": "bunx tsc -p packages/mui-lite --noEmit",
		"docs:dev": "bun run --filter docs dev",
		"docs:build": "bun run --filter docs build",
		"docs:start": "bun run --filter docs start"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.7.3"
	}
}
