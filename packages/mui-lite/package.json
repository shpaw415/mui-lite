{
	"name": "@shpaw415/mui-lite",
	"version": "0.1.5",
	"description": "Lightweight Material Design components for React 19 — MUI-like APIs without Emotion",
	"type": "module",
	"license": "MIT",
	"author": "shpaw415",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shpaw415/mui-lite.git",
		"directory": "packages/mui-lite"
	},
	"bugs": {
		"url": "https://github.com/shpaw415/mui-lite/issues"
	},
	"homepage": "https://github.com/shpaw415/mui-lite#readme",
	"keywords": [
		"mui",
		"material-ui",
		"react",
		"components",
		"ui",
		"css",
		"ssr",
		"typescript"
	],
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		"./package.json": "./package.json",
		"./style.css": "./dist/style/mui-style.css",
		"./theme": {
			"types": "./dist/common/theme/index.d.ts",
			"import": "./dist/common/theme/index.js",
			"default": "./dist/common/theme/index.js"
		},
		"./utils": {
			"types": "./dist/common/utils.d.ts",
			"import": "./dist/common/utils.js",
			"default": "./dist/common/utils.js"
		},
		"./locale": {
			"types": "./dist/mui/locale/index.d.ts",
			"import": "./dist/mui/locale/index.js",
			"default": "./dist/mui/locale/index.js"
		},
		"./*": {
			"types": "./dist/mui/*/index.d.ts",
			"import": "./dist/mui/*/index.js",
			"default": "./dist/mui/*/index.js"
		}
	},
	"typesVersions": {
		"*": {
			"theme": [
				"dist/common/theme/index.d.ts"
			],
			"utils": [
				"dist/common/utils.d.ts"
			],
			"locale": [
				"dist/mui/locale/index.d.ts"
			],
			"*": [
				"dist/mui/*/index.d.ts"
			]
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"prepublishOnly": "node scripts/build.mjs",
		"test": "bun test tests",
		"typecheck": "bunx tsc -p tsconfig.json --noEmit"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "latest",
		"@types/react": "19.0.10",
		"@types/react-dom": "19.0.4",
		"happy-dom": "^17.1.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.7.3"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@material-design-icons/svg": "0.14.13",
		"clsx": "2.1.1",
		"css-color-converter": "2.0.0"
	},
	"private": false
}
