{
	"compilerOptions": {
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"target": "ES2020",
		"module": "ESNext",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": ".",
		"noCheck": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true
	},
	"include": ["./custom.d.ts", "./mui", "./common"],
	"exclude": ["./node_modules", "./tests", "./dist", "./scripts"]
}
